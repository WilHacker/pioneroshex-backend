PORT=3001
NODE_ENV=development

# PostgreSQL (usadas por docker-compose y por la app)
POSTGRES_USER=pioneros_admin
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=pioneroshex_db
DATABASE_URL=postgresql://pioneros_admin:cambiar_esta_clave@localhost:5432/pioneroshex_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# URL del frontend (CORS). Varios orígenes separados por comas; para jugar desde otros
# dispositivos de la casa añade la IP de este PC, p. ej.:
# FRONTEND_URL=http://localhost:3000,http://192.168.1.20:3000
FRONTEND_URL=http://localhost:3000
