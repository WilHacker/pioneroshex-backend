{
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:cov)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Edit(./.env)", "Edit(./.env.local)"]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "design@knowledge-work-plugins": false
  }
}
